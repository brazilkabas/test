DATABASE_URL=postgresql://company_control:company_control@localhost:5432/company_control
MICROSOFT_CLIENT_ID=
MICROSOFT_RESOURCE_APP_ID=
MICROSOFT_RESOURCE_SCOPE=
# Separate Entra public client used only for attached Microsoft Graph mail access.
# Configure delegated User.Read and Mail.Read permissions. No primary client fallback is used.
MICROSOFT_GRAPH_MAIL_CLIENT_ID=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations
# Defaults to APP_BASE_URL/api/v1/microsoft/callback.
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/microsoft/callback
# For Graph, use resource app ID 00000003-0000-0000-c000-000000000000
# and explicit delegated scopes such as User.Read,Mail.Read.
# 32-byte key encoded as 64 hexadecimal characters.
ENCRYPTION_KEY=
# 32+ random characters used to sign application sessions.
SESSION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Advanced modules (not required by milestone one)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_BASE_DOMAIN=
# Optional: pre-created namespace bound to the wildcard Worker as DEPLOYMENTS.
CLOUDFLARE_KV_NAMESPACE_ID=

# Optional official Exchange Online PowerShell administration
EXCHANGE_ENABLED=false
EXCHANGE_ORGANIZATION=
EXCHANGE_APP_ID=
EXCHANGE_CERTIFICATE_THUMBPRINT=
EXCHANGE_POWERSHELL_PATH=pwsh
