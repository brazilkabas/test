{
  "name": "company-control",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm test --workspace @company-control/desktop-companion",
    "ai-code:agent": "tsx scripts/ai-code-local-agent.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "microsoft:smoke": "tsx scripts/microsoft-smoke.ts",
    "desktop:build": "npm run build --workspace @company-control/desktop-companion"
  },
  "dependencies": {
    "@azure/msal-node": "latest",
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.12.0",
    "dotenv": "^17.4.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.45.0",
    "next": "latest",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "sanitize-html": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "^6.12.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
